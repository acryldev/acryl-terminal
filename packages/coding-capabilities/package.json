{
  "name": "@acryldev/coding-capabilities",
  "version": "0.1.0",
  "private": true,
  "description": "How ACRYL's coding capabilities compose on each product surface: the Loader rows, the packages a surface must make resolvable, and the shell-mode split. The Blueprint vocabulary stays in @acryldev/harness-runtime.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@acryldev/ui": "0.4.0",
    "@acryldev/agent-control": "0.1.0",
    "@acryldev/app-save": "0.1.0",
    "@acryldev/app-shell": "0.2.1",
    "@acryldev/brand": "0.1.0",
    "@acryldev/command-reply": "0.1.0",
    "@acryldev/launcher-desktop": "0.1.9",
    "@acryldev/mount-anchors": "0.1.0",
    "@acryldev/plugin-admin": "0.2.1",
    "@acryldev/plugin-context": "0.1.1",
    "@acryldev/plugin-hub": "0.1.0",
    "@acryldev/settings": "0.2.1",
    "@acryldev/shortcuts": "0.1.0",
    "@acryldev/sign-in": "0.2.2",
    "@acryldev/support": "0.2.1",
    "@acryldev/system-prompt": "0.3.0",
    "@acryldev/ui-tui": "0.1.0",
    "@acryldev/workspace": "0.2.3",
    "@acryldev/cordis-plugin-market": "0.1.0",
    "@acryldev/brand-client": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
